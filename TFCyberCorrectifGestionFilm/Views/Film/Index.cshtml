@model List<TFCyberCorrectifGestionFilm.Models.Film>

<div>
	<h1> @ViewData["TitrePage"]</h1>

	<p> Nombre de films : @ViewBag.NombreFilms</p>

	@if (TempData["Message"] != null)
	{
		<p class="alert alert-warning">@TempData["Message"]</p>
	}

	<table class="table table-striped">
		<thead>
			<tr>
				<th>Id</th>
				<th>Titre</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			@foreach (Film film in Model)
			{
				<tr>
					<td>@film.Id</td>
					<td>@film.Titre</td>
					<td>
						<a class="btn btn-primary" asp-action="Details" asp-route-id="@film.Id">Détails</a>
						<a class="btn btn-danger" asp-action="Supprimer" asp-route-id="@film.Id">Supprimer</a>
					</td>
				</tr>
			}
		</tbody>
	</table>

	@if (Model.Count == 0)
	{
		<p class="alert alert-warning">Aucun film trouvé.</p>
	}

	<a class="btn btn-secondary" asp-action="Index" asp-route-trierCroissant="true">Trier par titre croissant</a>
</div>
