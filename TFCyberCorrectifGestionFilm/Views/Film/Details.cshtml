@model TFCyberCorrectifGestionFilm.Models.Film

<div>
	<h1>@ViewData["TitrePage"]</h1>

	<p><strong>Id :</strong> @Model.Id</p>
	<p><strong>Titre :</strong> @Model.Titre</p>
