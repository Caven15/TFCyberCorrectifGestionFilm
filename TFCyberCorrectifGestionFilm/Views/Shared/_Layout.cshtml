<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TFCyberCorrectifGestionFilm</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TFCyberCorrectifGestionFilm.styles.css" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.min.js" defer></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container">
                <a class="navbar-brand" asp-controller="Film" asp-action="Index">Gestion Films</a>
                <div class="navbar-nav">
                    <a class="nav-link" asp-controller="Film" asp-action="Index">Tout les films</a>
                    <a class="nav-link" asp-controller="Film" asp-action="Index" asp-route-genre="Science-fiction">Science-fiction</a>
                    <a class="nav-link" asp-controller="Film" asp-action="Apropos" >À propos</a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
